<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Chats</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h3>All Chats</h3>
    <form action="/chats/new" method="get">
        <button>Create new chat</button>
    </form>
    <br><br>
    <div id="chats">
        <% for(let chat of chats){ %>
            <div class="chat">
            <p>From: <%= chat.from %></p>
            <div class="msg">
                <p><%= chat.msg %></p>
                <form action="/chats/<%= chat._id %>/edit" method="get">
                    <button>Edit msg</button>
                </form> <br><br>
                <form action="/chats/<%= chat._id %>?_method=delete" method="post" class="deleteBtn">
                    <button>Delete chat</button>
                </form>
            </div>
            <p>Received by: <%= chat.to %></p>
            <p><%= chat.created_at.toString().split(' ')[4]%></p>
            <p><%= chat.created_at.toString().split(' ').splice(0,4).join('-') %></p>
            <hr>
        </div>
        <% } %>
    </div>
    <script src="/app.js"></script>
</body>
</html>